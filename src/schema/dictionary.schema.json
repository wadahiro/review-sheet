{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "review-sheet dictionary",
  "description": "<product>@<version>.yml — what a PRODUCT says about its own settings. Written wholesale by an extraction; a hand edit belongs in <product>@<version>.overlay.yml, whose accepted fields are deliberately narrower.",
  "type": "object",
  "required": [
    "product",
    "version",
    "parameters"
  ],
  "additionalProperties": false,
  "properties": {
    "product": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "$ref": "#/definitions/langProvenance"
    },
    "coverage": {
      "enum": [
        "full",
        "partial"
      ]
    },
    "generated_by": {
      "type": "string",
      "minLength": 1
    },
    "docs_url": {
      "$ref": "#/definitions/url"
    },
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/definitions/parameter"
      }
    }
  },
  "definitions": {
    "provenance": {
      "enum": [
        "official",
        "community",
        "machine",
        "extracted",
        "project"
      ]
    },
    "langProvenance": {
      "anyOf": [
        {
          "$ref": "#/definitions/provenance"
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "en": {
              "$ref": "#/definitions/provenance"
            },
            "ja": {
              "$ref": "#/definitions/provenance"
            }
          }
        }
      ]
    },
    "langText": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1
            },
            "ja": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "label": {
          "$ref": "#/definitions/langText"
        },
        "description": {
          "$ref": "#/definitions/langText"
        },
        "default": {
          "oneOf": [
            {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            {
              "type": "object",
              "minProperties": 2,
              "propertyNames": {
                "minLength": 1
              },
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            }
          ]
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "value",
            "container"
          ]
        },
        "ui": {
          "enum": [
            "editable",
            "readonly",
            "absent"
          ]
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/paramOption"
          }
        },
        "secret": {
          "type": "boolean"
        },
        "docs_url": {
          "$ref": "#/definitions/url"
        },
        "provenance": {
          "$ref": "#/definitions/langProvenance"
        }
      },
      "allOf": [
        {
          "$comment": "A container groups other objects and has no value of its own, so it has no default either — and a default here is an object, which is not what the field may hold. This pairing is what materialize reads to keep such an entry out of the inventory.",
          "if": {
            "properties": {
              "kind": {
                "const": "container"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "required": [
                "default"
              ]
            }
          }
        }
      ]
    },
    "paramOption": {
      "type": "object",
      "required": [
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "description": "The STORED form, verbatim — what a config file holds. Never a display form."
        },
        "label": {
          "$ref": "#/definitions/langText"
        }
      }
    }
  }
}
