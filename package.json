{
  "name": "review-sheet",
  "version": "0.1.0",
  "type": "module",
  "description": "CLI tool and library that generates reviewable parameter sheet HTML from JSON input",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "review-sheet": "./src/cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc -p tsconfig.test.json",
    "build:app": "bun build ./src/html/app.ts --outdir ./dist --minify",
    "dev": "bun run src/cli.ts",
    "docs": "bun run scripts/gen-docs.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@ast-grep/lang-python": "^0.0.6",
    "@ast-grep/napi": "^0.44.0",
    "@picocss/pico": "2.1.1",
    "ajv": "8.20.0",
    "commander": "15.0.0",
    "htm": "3.1.1",
    "marked": "^18.0.9",
    "preact": "10.29.2",
    "saxes": "^6.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "bun-types": "1.3.14"
  }
}
